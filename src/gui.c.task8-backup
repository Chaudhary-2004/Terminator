#include "gui.h"
#include "shell.h"

#include <X11/Xlib.h>
#include <X11/Xutil.h>
#include <X11/keysym.h>

#include <stdio.h>
#include <stdlib.h>
#include <string.h>
#include <unistd.h>
#include <limits.h>
#include <sys/select.h>
#include <sys/time.h>
#include <signal.h>
#include <fcntl.h>
#include <sys/types.h>
#include <sys/wait.h>
#include <errno.h>

#define WINDOW_WIDTH 800
#define WINDOW_HEIGHT 500
#define GUI_MAX_INPUT 1024
#define MAX_OUTPUT 16000
#define LINE_HEIGHT 20
#define PROMPT "user@terminator> "
#define HISTORY_FILE ".terminator_history"
#define HISTORY_SIZE 1000
#define MAX_TABS 8
#define TAB_BAR_HEIGHT 58

static Display *d;
static Window w;
static GC g;

typedef struct
{
    char input[GUI_MAX_INPUT];
    int input_len;

    char output[MAX_OUTPUT];
    int exit_status;

    int history_position;

    int search_mode;
    char search_query[GUI_MAX_INPUT];
    char search_saved_input[GUI_MAX_INPUT];
    int search_index;

    char cwd[PATH_MAX];

    /* Asynchronous foreground command state for this tab. */
    pid_t command_pgid;
    int command_fd;
    int command_running;
} Tab;

static Tab tabs[MAX_TABS];
static int tab_count = 1;
static int active_tab = 0;

static int multiwatch_tab_index = -1;
/* Most recently launched foreground worker; Ctrl+C works after tab switching. */
static pid_t foreground_worker_pgid = 0;

/* Command history is shared by all tabs. */
static char history[HISTORY_SIZE][GUI_MAX_INPUT];
static int history_count = 0;

static Tab *current_tab(void)
{
    return &tabs[active_tab];
}

/* ---------- Tab bar ---------- */

static void draw_tab_bar(void)
{
    int a;
    int x = 10;
    char label[64];

    /* Row 1: keyboard shortcuts */
    XDrawString(d, w, g, 10, 17,
                "Ctrl+T: New | Ctrl+Tab: Next | Ctrl+W: Close",
                46);

    /* Row 2: tab names */
    for (a = 0; a < tab_count; a++)
    {
        snprintf(label, sizeof(label), "%sTab %d",
                 a == active_tab ? "[*] " : "[ ] ",
                 a + 1);

        XDrawString(d, w, g, x, 42,
                    label, (int)strlen(label));

        x += (int)strlen(label) * 8 + 12;
    }

    /* Separator below the tab bar */
    XDrawLine(d, w, g, 0, 52,
              WINDOW_WIDTH, 52);
}

/* ---------- Output display ---------- */

static void draw_output(void)
{
    Tab *t = current_tab();
    int a;
    int b;
    int newline_count = 0;
    int y = TAB_BAR_HEIGHT + LINE_HEIGHT;
    int max_lines =
        (WINDOW_HEIGHT - TAB_BAR_HEIGHT - 45) / LINE_HEIGHT;

    for (a = 0; t->output[a] != '\0'; a++)
    {
        if (t->output[a] == '\n')
            newline_count++;
    }

    a = 0;

    while (newline_count > max_lines && t->output[a] != '\0')
    {
        if (t->output[a] == '\n')
            newline_count--;

        a++;
    }

    while (t->output[a] != '\0' && y < WINDOW_HEIGHT - 25)
    {
        b = a;

        while (t->output[b] != '\0' &&
               t->output[b] != '\n' &&
               t->output[b] != '\r')
        {
            b++;
        }

        if (b > a)
        {
            XDrawString(d, w, g, 10, y,
                        t->output + a, b - a);

            y += LINE_HEIGHT;
        }

        a = b;

        while (t->output[a] == '\n' || t->output[a] == '\r')
            a++;
    }
}

/* ---------- History search ---------- */

static int find_history_match(const char *query, int start)
{
    int a;

    if (query == NULL || query[0] == '\0')
        return -1;

    if (start >= history_count)
        start = history_count - 1;

    for (a = start; a >= 0; a--)
    {
        if (strstr(history[a], query) != NULL)
            return a;
    }

    return -1;
}

/* ---------- Redraw ---------- */

static void redraw(void)
{
    Tab *t = current_tab();
    char prompt[GUI_MAX_INPUT + 128];

    XClearWindow(d, w);

    draw_tab_bar();
    draw_output();

    if (t->search_mode)
    {
        const char *match;

        if (t->search_index >= 0)
            match = history[t->search_index];
        else
            match = "(no match)";

        snprintf(prompt, sizeof(prompt),
                 "(reverse-i-search)`%.100s': %.1000s",
                 t->search_query, match);
    }
    else
    {
        snprintf(prompt, sizeof(prompt),
                 "%s%s", PROMPT, t->input);
    }

    XDrawString(d, w, g, 10, WINDOW_HEIGHT - 15,
                prompt, (int)strlen(prompt));

    XFlush(d);
}

/* ---------- Save and load history ---------- */

static void save_history(const char *command)
{
    char path[PATH_MAX];
    const char *home = getenv("HOME");
    FILE *fp;

    if (command == NULL || command[0] == '\0')
        return;

    if (history_count > 0 &&
        strcmp(history[history_count - 1], command) == 0)
    {
        current_tab()->history_position = history_count;
        return;
    }

    if (history_count == HISTORY_SIZE)
    {
        memmove(history, history + 1,
                sizeof(history[0]) * (HISTORY_SIZE - 1));

        history_count--;
    }

    snprintf(history[history_count],
             sizeof(history[history_count]),
             "%s", command);

    history_count++;

    current_tab()->history_position = history_count;

    if (home == NULL)
        return;

    if (snprintf(path, sizeof(path), "%s/%s",
                 home, HISTORY_FILE) >= (int)sizeof(path))
    {
        return;
    }

    fp = fopen(path, "a");

    if (fp == NULL)
        return;

    fprintf(fp, "%s\n", command);
    fclose(fp);
}

static void load_history(void)
{
    char path[PATH_MAX];
    char line[GUI_MAX_INPUT];
    const char *home = getenv("HOME");
    FILE *fp;
    int a;

    if (home == NULL)
        return;

    if (snprintf(path, sizeof(path), "%s/%s",
                 home, HISTORY_FILE) >= (int)sizeof(path))
    {
        return;
    }

    fp = fopen(path, "r");

    if (fp == NULL)
        return;

    while (fgets(line, sizeof(line), fp) != NULL)
    {
        line[strcspn(line, "\r\n")] = '\0';

        if (line[0] == '\0')
            continue;

        if (history_count == HISTORY_SIZE)
        {
            memmove(history, history + 1,
                    sizeof(history[0]) * (HISTORY_SIZE - 1));

            history_count--;
        }

        snprintf(history[history_count],
                 sizeof(history[history_count]),
                 "%s", line);

        history_count++;
    }

    fclose(fp);

    for (a = 0; a < MAX_TABS; a++)
        tabs[a].history_position = history_count;
}

/* ---------- Output buffer ---------- */

static void append_output_to(Tab *t, const char *text)
{
    size_t used;
    size_t available;
    size_t len;

    if (t == NULL || text == NULL)
        return;

    used = strlen(t->output);
    available = sizeof(t->output) - used - 1;
    len = strlen(text);

    if (len > available)
    {
        size_t keep = sizeof(t->output) / 2;
        size_t old_len = strlen(t->output);

        if (old_len > keep)
        {
            memmove(t->output, t->output + old_len - keep, keep);
            t->output[keep] = '\0';
        }

        used = strlen(t->output);
        available = sizeof(t->output) - used - 1;
        len = strlen(text);

        if (len > available)
        {
            text += len - available;
            len = available;
        }
    }

    memcpy(t->output + used, text, len);
    t->output[used + len] = '\0';
}

static void append_output(const char *text)
{
    append_output_to(current_tab(), text);
}

/* The worker forwards terminal-style signals to its shell-managed pipeline. */
static void foreground_worker_signal(int signal_number)
{
    shell_handle_signal(signal_number);
}

static int command_is_shell_builtin_or_background(const char *command)
{
    char first[32];
    size_t n = 0;
    const char *p = command;

    /* Background jobs must stay in the main shell's job table. */
    if (strchr(command, '&') != NULL)
        return 1;

    /* Pipelines/redirections can block, so run them asynchronously. */
    if (strpbrk(command, "|<>") != NULL)
        return 0;

    while (*p == ' ' || *p == '\t')
        p++;

    while (*p != '\0' && *p != ' ' && *p != '\t' &&
           n + 1 < sizeof(first))
        first[n++] = *p++;

    first[n] = '\0';

    return strcmp(first, "cd") == 0 ||
           strcmp(first, "jobs") == 0 ||
           strcmp(first, "fg") == 0 ||
           strcmp(first, "bg") == 0 ||
           strcmp(first, "pwd") == 0 ||
           strcmp(first, "exit") == 0;
}

static void start_foreground_worker(Tab *t, const char *command)
{
    int output_pipe[2];
    pid_t child;

    if (t->command_running)
    {
        append_output_to(t, "A foreground command is already running in this tab.\n");
        return;
    }

    if (pipe(output_pipe) == -1)
    {
        char message[128];
        snprintf(message, sizeof(message), "pipe: %s\n", strerror(errno));
        append_output_to(t, message);
        return;
    }

    child = fork();

    if (child == -1)
    {
        char message[128];
        int saved_errno = errno;
        close(output_pipe[0]);
        close(output_pipe[1]);
        snprintf(message, sizeof(message), "fork: %s\n", strerror(saved_errno));
        append_output_to(t, message);
        return;
    }

    if (child == 0)
    {
        struct sigaction action;
        char result[MAX_OUTPUT];
        int status = 0;
        size_t sent = 0;
        size_t result_len;

        close(output_pipe[0]);
        (void)setpgid(0, 0);

        memset(&action, 0, sizeof(action));
        action.sa_handler = foreground_worker_signal;
        sigemptyset(&action.sa_mask);
        action.sa_flags = 0;
        (void)sigaction(SIGINT, &action, NULL);
        (void)sigaction(SIGTSTP, &action, NULL);

        run_command(command, result, sizeof(result), &status);

        result_len = strlen(result);
        while (sent < result_len)
        {
            ssize_t written = write(output_pipe[1], result + sent,
                                    result_len - sent);
            if (written > 0)
                sent += (size_t)written;
            else if (written == -1 && errno == EINTR)
                continue;
            else
                break;
        }

        close(output_pipe[1]);
        _exit(status < 0 ? 1 : (status > 255 ? 255 : status));
    }

    close(output_pipe[1]);
    (void)setpgid(child, child);

    {
        int flags = fcntl(output_pipe[0], F_GETFL, 0);
        if (flags == -1 ||
            fcntl(output_pipe[0], F_SETFL, flags | O_NONBLOCK) == -1)
        {
            int saved_errno = errno;
            (void)kill(-child, SIGTERM);
            close(output_pipe[0]);
            (void)waitpid(child, NULL, 0);
            {
                char message[128];
                snprintf(message, sizeof(message), "fcntl: %s\n",
                         strerror(saved_errno));
                append_output_to(t, message);
            }
            return;
        }
    }

    t->command_pgid = child;
    t->command_fd = output_pipe[0];
    t->command_running = 1;
    foreground_worker_pgid = child;
}

static void poll_foreground_workers(void)
{
    int a;
    int changed = 0;
    char buffer[1024];

    for (a = 0; a < tab_count; a++)
    {
        Tab *t = &tabs[a];

        if (!t->command_running)
            continue;

        if (t->command_fd >= 0)
        {
            for (;;)
            {
                ssize_t n = read(t->command_fd, buffer, sizeof(buffer) - 1);
                if (n > 0)
                {
                    buffer[n] = '\0';
                    append_output_to(t, buffer);
                    changed = 1;
                    continue;
                }

                if (n == 0)
                {
                    close(t->command_fd);
                    t->command_fd = -1;
                    break;
                }

                if (errno == EINTR)
                    continue;

                if (errno == EAGAIN || errno == EWOULDBLOCK)
                    break;

                close(t->command_fd);
                t->command_fd = -1;
                break;
            }
        }

        {
            int status;
            pid_t waited = waitpid(t->command_pgid, &status, WNOHANG);

            if (waited == t->command_pgid ||
                (waited == -1 && errno == ECHILD))
            {
                if (waited == t->command_pgid)
                {
                    if (WIFEXITED(status))
                        t->exit_status = WEXITSTATUS(status);
                    else if (WIFSIGNALED(status))
                        t->exit_status = 128 + WTERMSIG(status);
                }

                if (t->command_fd == -1)
                {
                    t->command_running = 0;
                    if (foreground_worker_pgid == t->command_pgid)
                        foreground_worker_pgid = 0;
                    t->command_pgid = 0;
                    changed = 1;
                }
            }
        }
    }

    if (changed)
        redraw();
}

/* ---------- Command execution ---------- */

static void execute_current_command(void)
{
    Tab *t = current_tab();

    char command[GUI_MAX_INPUT];
    char result[MAX_OUTPUT];
    char line[GUI_MAX_INPUT + 64];
    char original_cwd[PATH_MAX];

    if (t->input_len > 0)
    {
        snprintf(command, sizeof(command), "%s", t->input);

        save_history(command);

        snprintf(line, sizeof(line), "%s%s\n", PROMPT, command);
        append_output(line);

        original_cwd[0] = '\0';
        if (getcwd(original_cwd, sizeof(original_cwd)) == NULL)
            original_cwd[0] = '\0';

        if (t->cwd[0] != '\0' && chdir(t->cwd) == -1)
        {
            append_output("Could not change to this tab's directory.\n");
        }
        else if (strncmp(command, "multiWatch", 10) == 0 &&
                 (command[10] == '\0' || command[10] == ' ' ||
                  command[10] == '\t' || command[10] == '['))
        {
            if (shell_multiwatch_active())
            {
                append_output_to(t, "multiWatch is already running. Press Ctrl+C to stop it.\n");
            }
            else
            {
                result[0] = '\0';
                if (shell_multiwatch_start(command, result, sizeof(result)) == 0)
                    multiwatch_tab_index = active_tab;

                if (result[0] != '\0')
                    append_output_to(t, result);
            }
        }
        else if (command_is_shell_builtin_or_background(command))
        {
            run_command(command, result, sizeof(result), &t->exit_status);
            append_output(result);

            if (getcwd(t->cwd, sizeof(t->cwd)) == NULL)
                t->cwd[0] = '\0';
        }
        else
        {
            start_foreground_worker(t, command);
        }

        if (original_cwd[0] != '\0')
            (void)chdir(original_cwd);
    }

    t->input[0] = '\0';
    t->input_len = 0;
    t->history_position = history_count;
}

/* ---------- Tab management ---------- */

static void open_tab(void)
{
    int new_index;

    if (tab_count >= MAX_TABS)
    {
        append_output("Maximum number of tabs reached.\n");
        return;
    }

    new_index = tab_count;

    memset(&tabs[new_index], 0, sizeof(tabs[new_index]));
    tabs[new_index].command_fd = -1;

    tabs[new_index].history_position = history_count;
    tabs[new_index].search_index = -1;

    if (getcwd(tabs[new_index].cwd,
               sizeof(tabs[new_index].cwd)) == NULL)
    {
        tabs[new_index].cwd[0] = '\0';
    }

    snprintf(tabs[new_index].output,
             sizeof(tabs[new_index].output),
             "Welcome to Terminator - Tab %d\n",
             new_index + 1);

    tab_count++;
    active_tab = new_index;
}

static void close_active_tab(void)
{
    int a;

    if (tab_count == 1)
    {
        snprintf(current_tab()->output,
                 sizeof(current_tab()->output),
                 "This is the last tab. Close the window to exit.\n");
        return;
    }

    if (current_tab()->command_running && current_tab()->command_pgid > 0)
    {
        (void)kill(-current_tab()->command_pgid, SIGINT);
        if (current_tab()->command_fd >= 0)
            close(current_tab()->command_fd);
        (void)waitpid(current_tab()->command_pgid, NULL, 0);
        if (foreground_worker_pgid == current_tab()->command_pgid)
            foreground_worker_pgid = 0;
    }

    for (a = active_tab; a < tab_count - 1; a++)
        tabs[a] = tabs[a + 1];

    memset(&tabs[tab_count - 1], 0, sizeof(tabs[tab_count - 1]));

    tab_count--;

    if (active_tab >= tab_count)
        active_tab = tab_count - 1;
}

static void next_tab(void)
{
    if (tab_count > 1)
        active_tab = (active_tab + 1) % tab_count;
}

/* ---------- Main X11 event loop ---------- */

void run_gui(void)
{
    XEvent e;
    KeySym k;
    char key[32];
    int n;
    int s;

    memset(tabs, 0, sizeof(tabs));
    { int a; for (a = 0; a < MAX_TABS; a++) tabs[a].command_fd = -1; }
    foreground_worker_pgid = 0;
    multiwatch_tab_index = -1;

    tab_count = 1;
    active_tab = 0;
    history_count = 0;

    if (getcwd(tabs[0].cwd, sizeof(tabs[0].cwd)) == NULL)
        tabs[0].cwd[0] = '\0';

    d = XOpenDisplay(NULL);

    if (d == NULL)
    {
        fprintf(stderr, "terminator: cannot open X display\n");
        return;
    }

    s = DefaultScreen(d);

    w = XCreateSimpleWindow(
        d,
        RootWindow(d, s),
        100, 100,
        WINDOW_WIDTH, WINDOW_HEIGHT,
        1,
        BlackPixel(d, s),
        BlackPixel(d, s));

    XStoreName(d, w, "Terminator");

    XSelectInput(d, w,
                 ExposureMask |
                     KeyPressMask |
                     StructureNotifyMask);

    g = XCreateGC(d, w, 0, NULL);

    XSetForeground(d, g, WhitePixel(d, s));

    XMapWindow(d, w);

    snprintf(tabs[0].output, sizeof(tabs[0].output),
             "Welcome to Terminator!\n"
             "Type a Linux command and press Enter.\n");

    load_history();

    while (1)
    {
        Tab *t;

        /*
         * Wait for X11 input with a short timeout. This avoids busy-waiting
         * while still allowing background shell jobs to be polled regularly.
         */
        if (XPending(d) == 0)
        {
            fd_set read_fds;
            struct timeval timeout;
            int x_fd = ConnectionNumber(d);

            FD_ZERO(&read_fds);
            FD_SET(x_fd, &read_fds);

            timeout.tv_sec = 0;
            timeout.tv_usec = 100000; /* 100 ms */

            (void)select(x_fd + 1, &read_fds, NULL, NULL, &timeout);
        }

        /*
         * Collect any output or completion notifications from background jobs.
         * shell_poll_jobs() is non-blocking, so keyboard input remains responsive.
         */
        {
            char job_output[MAX_OUTPUT];

            if (shell_poll_jobs(job_output, sizeof(job_output)))
            {
                append_output(job_output);
                redraw();
            }
        }

        poll_foreground_workers();

        /* Route multiWatch output to the tab that launched it. */
        {
            char watch_output[MAX_OUTPUT];

            if (shell_multiwatch_active() &&
                shell_multiwatch_poll(watch_output, sizeof(watch_output)))
            {
                if (multiwatch_tab_index >= 0 &&
                    multiwatch_tab_index < tab_count)
                {
                    append_output_to(&tabs[multiwatch_tab_index], watch_output);
                    redraw();
                }
            }
        }

        if (XPending(d) == 0)
            continue;

        XNextEvent(d, &e);

        if (e.type == Expose)
        {
            redraw();
        }
        else if (e.type == KeyPress)
        {
            n = XLookupString(&e.xkey, key,
                              sizeof(key), &k, NULL);

            t = current_tab();
            /* Ctrl+C interrupts the running command, even after switching tabs. */
            if ((e.xkey.state & ControlMask) &&
                (k == XK_c || k == XK_C))
            {
                if (shell_multiwatch_active())
                {
                    shell_multiwatch_stop();

                    if (multiwatch_tab_index >= 0 &&
                        multiwatch_tab_index < tab_count)
                    {
                        append_output_to(&tabs[multiwatch_tab_index], "^C\n");
                    }
                    multiwatch_tab_index = -1;
                }
                else if (foreground_worker_pgid > 0)
                {
                    int a;
                    (void)kill(-foreground_worker_pgid, SIGINT);
                    for (a = 0; a < tab_count; a++)
                    {
                        if (tabs[a].command_running &&
                            tabs[a].command_pgid == foreground_worker_pgid)
                        {
                            append_output_to(&tabs[a], "^C\n");
                            break;
                        }
                    }
                }
                else if (shell_foreground_running())
                {
                    shell_handle_signal(SIGINT);
                    append_output("^C\n");
                }

                redraw();
                continue;
            }

            /* Ctrl+Z forwards stop to the current foreground command. */
            if ((e.xkey.state & ControlMask) &&
                (k == XK_z || k == XK_Z))
            {
                if (foreground_worker_pgid > 0)
                    (void)kill(-foreground_worker_pgid, SIGTSTP);
                else
                    shell_handle_signal(SIGTSTP);
                append_output("^Z\n");
                redraw();
                continue;
            }

            /* Ctrl+T: open a tab. */
            if ((e.xkey.state & ControlMask) &&
                (k == XK_t || k == XK_T))
            {
                open_tab();
                redraw();
            }
            /* Ctrl+Tab: switch tabs. */
            else if ((e.xkey.state & ControlMask) &&
                     k == XK_Tab)
            {
                next_tab();
                redraw();
            }
            /* Ctrl+W: close the active tab. */
            else if ((e.xkey.state & ControlMask) &&
                     (k == XK_w || k == XK_W))
            {
                close_active_tab();
                redraw();
            }
            /* Ctrl+R: reverse history search. */
            else if ((e.xkey.state & ControlMask) &&
                     (k == XK_r || k == XK_R))
            {
                if (!t->search_mode)
                {
                    snprintf(t->search_saved_input,
                             sizeof(t->search_saved_input),
                             "%s", t->input);

                    t->search_query[0] = '\0';
                    t->search_index = -1;
                    t->search_mode = 1;
                }
                else if (t->search_index > 0)
                {
                    t->search_index =
                        find_history_match(
                            t->search_query,
                            t->search_index - 1);
                }
                else if (t->search_index == -1)
                {
                    t->search_index =
                        find_history_match(
                            t->search_query,
                            history_count - 1);
                }

                redraw();
            }
            else if (t->search_mode)
            {
                if (k == XK_Escape)
                {
                    t->search_mode = 0;

                    snprintf(t->input, sizeof(t->input),
                             "%s", t->search_saved_input);

                    t->input_len = (int)strlen(t->input);
                }
                else if (k == XK_BackSpace || k == XK_Delete)
                {
                    size_t len = strlen(t->search_query);

                    if (len > 0)
                        t->search_query[len - 1] = '\0';

                    t->search_index =
                        find_history_match(
                            t->search_query,
                            history_count - 1);
                }
                else if (k == XK_Return || k == XK_KP_Enter)
                {
                    if (t->search_index >= 0)
                    {
                        snprintf(t->input, sizeof(t->input),
                                 "%s", history[t->search_index]);

                        t->input_len = (int)strlen(t->input);
                    }

                    t->search_mode = 0;
                    t->history_position = history_count;
                }
                else if (n > 0 &&
                         key[0] >= 32 &&
                         key[0] != 127 &&
                         strlen(t->search_query) < GUI_MAX_INPUT - 1)
                {
                    size_t len = strlen(t->search_query);

                    t->search_query[len] = key[0];
                    t->search_query[len + 1] = '\0';

                    t->search_index =
                        find_history_match(
                            t->search_query,
                            history_count - 1);
                }

                redraw();
            }
            /* Up arrow: older command. */
            else if (k == XK_Up)
            {
                if (history_count > 0 &&
                    t->history_position > 0)
                {
                    t->history_position--;

                    snprintf(t->input, sizeof(t->input),
                             "%s", history[t->history_position]);

                    t->input_len = (int)strlen(t->input);
                }

                redraw();
            }
            /* Down arrow: newer command. */
            else if (k == XK_Down)
            {
                if (t->history_position < history_count - 1)
                {
                    t->history_position++;

                    snprintf(t->input, sizeof(t->input),
                             "%s", history[t->history_position]);

                    t->input_len = (int)strlen(t->input);
                }
                else
                {
                    t->history_position = history_count;
                    t->input[0] = '\0';
                    t->input_len = 0;
                }

                redraw();
            }
            /* Enter: execute command. */
            else if (k == XK_Return || k == XK_KP_Enter)
            {
                execute_current_command();
                redraw();

                if (shell_exit_requested())
                    break;
            }
            /* Backspace: delete one character. */
            else if (k == XK_BackSpace || k == XK_Delete)
            {
                if (t->input_len > 0)
                    t->input[--t->input_len] = '\0';

                redraw();
            }
            /* Normal typed character. */
            else if (n > 0 &&
                     key[0] >= 32 &&
                     key[0] != 127 &&
                     t->input_len < GUI_MAX_INPUT - 1)
            {
                t->input[t->input_len++] = key[0];
                t->input[t->input_len] = '\0';

                redraw();
            }
        }
    }

    if (shell_multiwatch_active())
        shell_multiwatch_stop();

    XFreeGC(d, g);
    XDestroyWindow(d, w);
    XCloseDisplay(d);
}